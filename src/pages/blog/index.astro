---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const oldestYear = items.length > 0
  ? Math.min(...items.map(n => n.data.date.getFullYear()))
  : null;

// Third-party coverage — kept as its own section below our posts, so
// external articles aren't presented as our own writing.
const press = (await getCollection('press'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtShort = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base
  title="Blog - TRI AI"
  description="Notes from TRI AI - programme launches, research output, community announcements, and press coverage."
>
  <section class="section">
    <div class="container">
      <header class="news-head" data-reveal>
        <p class="eyebrow mono">Blog</p>
        <h1 class="news-title">Notes from TRI&nbsp;AI.</h1>
        <p class="news-lede">
          Programme launches, research releases, and community announcements - written by us, in chronological order.
        </p>
        {items.length > 0 && oldestYear && (
          <p class="news-stat mono">
            <span class="news-stat-num">{items.length}</span>
            {items.length === 1 ? 'entry' : 'entries'}
            <span class="news-stat-sep" aria-hidden="true">·</span>
            From {oldestYear} to today
          </p>
        )}
      </header>

      {items.length === 0 ? (
        <p class="news-empty">News will appear here as it is published.</p>
      ) : (
        <ul class="news-list" data-reveal-stagger>
          {items.map(n => (
            <li class="news-row">
              <a href={`/blog/${n.id}`} class="news-link">
                <div class="news-meta">
                  <time class="news-date mono" datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
                  <span class={`tag tag-${n.data.division === 'parent' ? 'gold' : n.data.division}`}>
                    {n.data.division}
                  </span>
                </div>
                <h2 class="news-row-title">{n.data.title}</h2>
                <p class="news-row-excerpt">{n.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {press.length > 0 && (
    <>
      <hr class="divider-rule" />
      <section class="section" id="press">
        <div class="container">
          <header class="press-head" data-reveal>
            <p class="eyebrow mono">In the press</p>
            <h2 class="press-title">Coverage of our work.</h2>
            <p class="press-lede">
              Articles, talks, and mentions by other outlets — written about us, not by us.
            </p>
          </header>
          <ul class="press-list" data-reveal-stagger>
            {press.map(p => (
              <li class="press-row">
                <a href={p.data.url} target="_blank" rel="noopener" class="press-link">
                  <div class="press-meta">
                    <span class="press-outlet mono">{p.data.outlet}</span>
                    <span class="press-date mono">{fmtShort(p.data.date)}</span>
                  </div>
                  <h3 class="press-row-title">{p.data.title} <span class="press-ext" aria-hidden="true">↗</span></h3>
                  {p.data.excerpt && <p class="press-row-excerpt">{p.data.excerpt}</p>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </>
  )}

  <Newsletter />
</Base>

<style>
  .news-head {
    max-width: 720px;
    padding-block: clamp(40px, 6vw, 72px) 48px;
  }

  /* ─── In the press ─── */
  .press-head { max-width: 720px; margin-bottom: 40px; }
  .press-title {
    font-size: var(--t-display-m);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .press-lede { font-size: 15.5px; line-height: 1.6; color: var(--ink-mid); }
  .press-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .press-row { border-bottom: 1px solid var(--line); }
  .press-link {
    display: block;
    padding-block: 22px;
    text-decoration: none;
  }
  .press-meta {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .press-outlet {
    font-size: var(--t-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-deep);
    font-weight: 700;
  }
  [data-theme='dark'] .press-outlet { color: var(--gold); }
  .press-date { font-size: var(--t-mono-sm); color: var(--ink-faint); }
  .press-row-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 6px;
    transition: color 0.2s;
  }
  .press-link:hover .press-row-title { color: var(--gold-deep); }
  [data-theme='dark'] .press-link:hover .press-row-title { color: var(--gold); }
  .press-ext { font-size: 0.8em; color: var(--ink-faint); }
  .press-row-excerpt {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-mid);
    max-width: 68ch;
    margin: 0;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 14px;
  }
  .news-title {
    font-size: var(--t-display-l);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .news-lede {
    font-size: clamp(15.5px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--ink-mid);
    max-width: 56ch;
    margin-bottom: 24px;
  }
  .news-stat {
    margin-top: 4px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--t-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mid);
  }
  .news-stat-num {
    color: var(--gold-deep);
    font-weight: 700;
    font-size: 13px;
  }
  [data-theme='dark'] .news-stat-num { color: var(--gold); }
  .news-stat-sep { color: var(--ink-faint); opacity: 0.5; }
  .news-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .news-row { border-bottom: 1px solid var(--rule); }
  .news-link {
    display: block;
    padding-block: 28px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }
  .news-link:hover { opacity: 0.7; }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .news-date {
    font-size: var(--t-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .news-row-title {
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .news-row-excerpt {
    color: var(--ink-mid);
    font-size: 16px;
    line-height: 1.6;
    max-width: 70ch;
  }
  .news-empty {
    color: var(--ink-faint);
    padding-block: 40px;
  }
</style>
